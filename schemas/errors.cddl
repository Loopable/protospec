             "E_EVENT_ID_COLLISION" /
             "E_DECRYPTION_FAILED" /
             "E_SIGNATURE_INVALID" /
             "E_AUTH_MALFORMED" /
             "E_AUTH_INVALID" /
             "E_REPLAY" /
             "E_TIMESTAMP_OUT_OF_RANGE" /
