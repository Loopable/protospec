; errors.cddl - error object (spec/80-errors.md)

error_object = {
  0 => error_code,              ; error_code
  1 => text,                    ; message (not protocol semantics)
  ? 2 => request_id,            ; request_id (optional)
  3 => bool,                    ; retryable
  ? 4 => {* uint => any},       ; details (optional)
}

; Registered error codes (spec/80-errors.md section 80.2)
error_code = "E_MALFORMED_ENCODING" /
