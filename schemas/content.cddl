; content.cddl - plaintext content schemas (the encrypted payloads)
; (spec/50-social-relationships.md, spec/51-profiles.md, spec/54-messaging.md,
;  spec/55-content.md, spec/56-media-and-files.md, spec/53-contexts-and-membership.md)

; Post content (spec 55.1)
post_content = {
  0 => text,                          ; text (may be empty)
  ? 1 => [* object_reference],        ; attachments (optional)
  ? 2 => text,                        ; created_locale (optional, BCP 47)
}

; Reply content (spec 55.1)
reply_content = {
  0 => object_reference,              ; parent
  1 => text,                          ; text (may be empty)
  ? 2 => [* object_reference],        ; attachments (optional)
}

; Direct message content (spec 54.1)
direct_message_content = {
  0 => text,                          ; text (may be empty)
  ? 1 => [* object_reference],        ; attachments (optional)
}

; Profile content (spec 51.1)
profile_content = {
  ? 0 => text,                        ; display_name (optional)
  ? 1 => text,                        ; bio (optional)
  ? 2 => object_reference,            ; avatar (optional)
  ? 3 => object_reference,            ; banner (optional)
  ? 4 => text,                        ; pronouns (optional, free-form text)
}

; Relationship content (spec 50.3)
relationship_content = {
  ? 0 => [* text],                    ; labels (optional)
  ? 1 => text,                        ; annotation (optional)
}

; Media content (spec 56.1)
media_content = {
  1 => text,                          ; media_type (IANA MIME, lowercase)
  ? 2 => text,                        ; filename (optional)
  3 => uint,                          ; size (MUST equal length(data))
  4 => bytes,                         ; data (exact plaintext file bytes)
  ? 5 => media_metadata,              ; metadata (optional)
  ? 6 => object_reference,            ; thumbnail_reference (optional, spec 56.6)
}

; Media metadata (spec 56.1)
media_metadata = {
  ? 0 => uint,                        ; width (pixels, raster media)
  ? 1 => uint,                        ; height (pixels, raster media)
  ? 2 => uint,                        ; duration_ms (timed media)
}

; Notification content (spec 72.2)
notification_content = {
  0 => uint,                          ; kind (0..6)
  1 => account_id,                    ; actor_account_id
  ? 2 => object_reference,            ; reference (optional)
  ? 3 => text,                        ; text (optional)
}

; Membership content (spec 53.5)
membership_content = {
  0 => account_id,                    ; member_account_id
  ? 1 => uint,                        ; role (optional; 0 regular, 1 owner)
}

; Group metadata content (spec 53.6)
group_metadata_content = {
  0 => text,                          ; name
}