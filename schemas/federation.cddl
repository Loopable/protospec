; federation.cddl - federation endpoint request and response bodies
; (spec/60-federation.md, spec/62-synchronization.md)

; Event submission (spec 60.4) and object submission (spec 60.5) bodies and
; responses.

submit_events_request = [* event]
submit_objects_request = [* object_submission]

object_submission = object / media_upload_submission

; Account-authenticated media creation only. The wrapped envelope has suite 1,
; object_type 3, and empty ciphertext; the instance binds the finalized
; upload's bytes into ciphertext before storing the complete object.
media_upload_submission = {
  0 => media_upload_object,     ; object envelope with empty ciphertext
  1 => upload_id,               ; finalized upload resource token
}

media_upload_object = {
  0 => protocol_version,        ; protocol_version
  1 => object_id,               ; object_id
  2 => 3,                       ; object_type media
  3 => 1,                       ; streaming media encryption
  4 => version_id,              ; version_id
  5 => bytes .size 0,           ; nonce empty for suite 1
  6 => bytes .size 0,           ; transient: bound from upload before storage
  7 => [* recipient_key_record],; recipients
  ? 8 => {* uint => any},       ; metadata, per spec 33.6
}

upload_id = base32text

submit_result = {
  0 => event_id / object_id,    ; event_id or object_id
  1 => submit_status,           ; 0 accepted, 1 duplicate, 2 rejected
  ? 2 => error_object,          ; present when status = 2
}

submit_status = 0..2

; Batch missing-event fetch (spec 60.6)
fetch_events_request = {
  0 => [* event_id],            ; event_ids
}

; Exactly one of key 1 (found) or key 2 (not found / invalid) is present.
fetch_event_result = {
  0 => event_id,                ; event_id
  ? 1 => bytes,                 ; event (canonical bytes)
  ? 2 => error_object,          ; error
}

; Sync (spec/62-synchronization.md section 62.2)
sync_request = {
  ? 0 => bytes,                 ; cursor (absent = from the beginning)
  ? 1 => [* uint],              ; interest (absent = all registered types)
}

sync_page = {
  0 => bytes,                   ; cursor
  1 => [* event],               ; events
  2 => [* object],              ; objects
  3 => bool,                    ; more
}

; Capabilities (spec/81-versioning-and-capabilities.md)
capability = {
  0 => text,                    ; id
  1 => text,                    ; version
  2 => bool,                    ; mandatory
}

capabilities_response = [* capability]

; Device join request (spec/60-federation.md section 60.10). Unauthenticated:
; the submitting device is not yet authorized, so the keys are self-asserted.
device_join_request = {
  0 => account_id,              ; account_id
  1 => device_id,               ; device_id (16 random bytes, spec 10.4)
  2 => ed25519_public_key,      ; signing_public_key
  3 => x25519_public_key,       ; encryption_public_key
  4 => device_kind,             ; device_kind (spec 12.5)
  ? 5 => text,                  ; display_name (optional)
}
